# The settings of the model call. Copy this file to ".env" and fill it in.
# Git never sees ".env". This file, with no values, is in git.

# The address of the model service. It ends with "/openai/v1/".
BOOK_TELLER_MODEL_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/

# The name that you gave the model in your Azure resource.
BOOK_TELLER_MODEL_DEPLOYMENT=

# The two below have a default, in src/book_teller/settings.py.
# BOOK_TELLER_MODEL_THINKING=low
# BOOK_TELLER_MODEL_TIMEOUT_SECONDS=60
