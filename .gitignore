# Secrets: never in the repository
.env
.env.*
# The example is not a secret: it holds the names of the settings, no values.
!.env.example
*.pem
*.key

# Terraform: the state file can hold secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The coding agent: settings of one machine only
.claude/settings.local.json

# macOS
.DS_Store
